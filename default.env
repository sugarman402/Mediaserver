##Docker & global configs
DOCKER_HOST_IP=CHANGE_ME
RESTART_POLICY=always
TIMEZONE=Europe/London
LAN_DNS_SERVER=CHANGE_ME
BACKUP_FOLDER="/media/router/backup"
LOG_FILE="/opt/operations.log"

##Portainer configs and volumes
PORTAINER_LOCALTIME=/etc/localtime
DOCKER_SOCK=/var/run/docker.sock
CONFIG_FOLDER=/media/config
PORTAINER_DATA=${CONFIG_FOLDER}/portainer
PORTAINER_PORT=9000

##Traefik configs and volumes
TRAEFIK_LOGLEVEL=DEBUG
TRAEFIK_WEB_PORT=80
TRAEFIK_WEBSECURE_PORT=443
TRAEFIK_DASHBOARD_PORT=8090
TRAEFIK_ACMESTORAGE=acme.json
TRAEFIK_CASERVER=https://acme-v02.api.letsencrypt.org/directory
TRAEFIK_CASERVER_EMAIL=CHANGE_ME
TRAEFIK_LETSENCRYPT=${CONFIG_FOLDER}/letsencrypt
TRAEFIK_FOLDER=${CONFIG_FOLDER}/traefik
TRAEFIK_DOMAIN1=CHANGE_ME
TRAEFIK_DOMAIN2=CHANGE_ME
TRAEFIK_RESOLVER=myresolver
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINTS=websecure,web
TRAEFIK_LOGS_FOLDER=/logs

##Common folders
SERIES_FOLDER=/media/sorozatok
MOVIES_FOLDER=/media/filmek

#Samba configs
SAMBA_USER=CHANGE_ME
SAMBA_PASSWORD=CHANGE_ME
SAMBA_SHARE=/media
SAMBA_PORT=445

##Plex configs and volumes
PLEX_CONFIG=${CONFIG_FOLDER}/plex
PLEX_PORT1=32400
PLEX_SUBDOMAIN=plex
TRAKT_SYNC_CONFIG=${CONFIG_FOLDER}/plextraktsync

##Tautulli configs and volumes
TAUTULLI_PORT=8181
TAUTULLI_CONFIG=${CONFIG_FOLDER}/tautulli/
TAUTULLI_SUBDOMAIN=tautulli

##Radarr configs and volumes
RADARR_PORT=7878
RADARR_CONFIG=${CONFIG_FOLDER}/radarr
RADARR_SUBDOMAIN=radarr
RADARR_API=CHANGE_ME

##Sonarr configs and volumes
SONARR_PORT=8989
SONARR_CONFIG=${CONFIG_FOLDER}/sonarr
SONARR_SUBDOMAIN=sonarr
SONARR_API=CHANGE_ME

#Prowlarr configs and volumes
PROWLARR_PORT=9696
PROWLARR_CONFIG=${CONFIG_FOLDER}/prowlarr
PROWLARR_API=CHANGE_ME

#Bazarr configs and volumes
BAZARR_CONFIG=${CONFIG_FOLDER}/bazarr
BAZARR_PORT=6767
BAZARR_SUBDOMAIN=bazarr

##Overseerr configs and volumes
OVERSEERR_PORT=5055
OVERSEERR_SUBDOMAIN=overseerr
OVERSEERR_CONFIG=${CONFIG_FOLDER}/overseerr

##Qbittorrent and Utorrent configs and volumes
QB_PORT=8079
QB_DOWNLOADPORT=6881
QB_CONFIG=${CONFIG_FOLDER}/qbittorrent
QB_SUBDOMAIN=qb
QB_USER=admin
QB_PW=CHANGE_ME

##Prometheus configs and volumes
PROM_CONFIG=${CONFIG_FOLDER}/prometheus
PROM_PORT=9090

##Alertmanage configs and volumes
ALERTMANAGER_PORT1=9093
ALERTMANAGER_PORT2=9094
ALERTMANAGER_CONFIG=${CONFIG_FOLDER}/alertmanager/
DISCORD_WEBHOOK_URL=CHANGE_ME

##Grafana configs and volumes
GRAFANA_PORT=3000
GRAFANA_CONFIG=${CONFIG_FOLDER}/grafana

##Exporter configs and volumes
SONARR_METRICS=9707
RADARR_METRICS=9708
PROWLARR_METRICS=9709
SMARTCTL_EXPORTER_PORT=9633
CADVISOR_PORT=8085
NODEEXP_PORT=9100
QBEXP_PORT=8000

##Development configs
CODESERVER_PW=CHANGE_ME
CODESERVER_SUBDOMAIN=code
CODESERVER_CONFIG=${CONFIG_FOLDER}/code-server
CODESERVER_PORT=8443

